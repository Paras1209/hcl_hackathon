{
  "name": "onboardiq-server",
  "version": "1.0.0",
  "description": "OnboardIQ KYC Onboarding System - Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node scripts/seedDatabase.js",
    "test": "node --test src/tests/unit/**/*.test.js",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/unit",
    "test:workflow": "vitest run src/tests/unit/workflow.test.js",
    "test:integration": "vitest run src/tests/integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "batch": "node scripts/processBatchCli.js"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1156.0",
    "@aws-sdk/credential-providers": "^3.1156.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.40.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.10.0",
    "fast-levenshtein": "^3.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "papaparse": "^5.4.1",
    "pino": "^8.15.6",
    "pino-pretty": "^10.2.3",
    "resend": "^2.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "kyc",
    "onboarding",
    "banking",
    "maker-checker",
    "compliance"
  ],
  "author": "OnboardIQ Team",
  "license": "MIT"
}
